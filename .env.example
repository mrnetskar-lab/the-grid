# The Grid — environment variables
# Copy to .env and fill in at least one AI provider key

# --- LOCAL / COLAB OLLAMA (highest priority) ---
# Paste the Cloudflare tunnel URL from your Colab session here
# OLLAMA_BASE_URL=https://xyz.trycloudflare.com
# OLLAMA_MODEL=dolphin-mistral:latest   # or deepseek-coder:6.7b

# --- CLOUD PROVIDERS (fallback chain) ---
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=

# Optional: override model globally
# AI_MODEL=

# Optional: per-character model overrides
# NINA_MODEL=
# HAZEL_MODEL=
# IRIS_MODEL=
# VALE_MODEL=

PORT=3001

ADMIN_KEY=velora-admin-2025
COMFYUI_OUTPUT_DIR=C:/Users/mn/ComfyUI_windows_portable/ComfyUI/output
